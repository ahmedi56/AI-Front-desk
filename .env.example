# Copy to .env and fill in. Then:  chmod 600 .env     NEVER put this file in Git.
APP_ENV=production
DOMAIN=frontdesk.example.com
PUBLIC_BASE_URL=https://frontdesk.example.com

# Make these with:  python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# Make this with:   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=
DB_OWNER_PASSWORD=
DB_APP_PASSWORD=
COOKIE_SECURE=true

# AI. FREE providers only. NEVER add a card or billing to these accounts.
# Main provider: groq (default) or gemini. Backup (used when the main one is busy or down): leave empty or set gemini/groq.
LLM_PROVIDER=groq
LLM_FALLBACK_PROVIDER=
GROQ_API_KEY=
GEMINI_API_KEY=
# Copy the exact model id from Google AI Studio. Needed only if you use Gemini (main or backup).
GEMINI_MODEL=
# Leave empty to use the default (Groq: openai/gpt-oss-120b). Free limits are per model, so you may put a different model here.
MODEL_SIMPLE=
MODEL_HARD=
# LOCKED on purpose. The paid Anthropic provider only starts when this is true. Do not change it.
ALLOW_PAID_LLM=false
# Each client stores its OWN free AI key in Settings > AI account (encrypted with ENCRYPTION_KEY).
# May a client WITHOUT its own key use the GROQ_API_KEY above? Empty = yes on a laptop, no in production.
ALLOW_SHARED_AI_KEY=
ANTHROPIC_API_KEY=

# Phone and texts
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=            # your own number, used for alerts to business owners

# Voice platform: this must equal the secret you put in the Vapi dashboard
VAPI_WEBHOOK_SECRET=
# Optional extra Vapi assistant settings as JSON (voice, recording). Example: {"voice":{"provider":"11labs","voiceId":"..."}}
VOICE_EXTRA_ASSISTANT_JSON=

# Google Calendar (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email for reports and alerts (SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Public product page (http://.../product). Leave empty to show a placeholder such as [YOUR EMAIL].
PRODUCT_CONTACT_EMAIL=
PRODUCT_VIDEO_URL=
PRODUCT_OWNER_NAME=
PRODUCT_SETUP_PRICE=
PRODUCT_MONTHLY_PRICE=
# Short name of the demo business for the "Try the live demo" chat on the product page (for example: demo). Empty = no demo chat.
PRODUCT_DEMO_BUSINESS=

# Limits
MAX_STEPS_PER_TURN=6
MAX_STEPS_PER_CONVERSATION=40
MAX_COST_PER_CONVERSATION_USD=0.50
GLOBAL_KILL_SWITCH=false

# Optional but recommended: only these IP addresses can open /admin (separate several with spaces).
# Leave the line out to allow everyone to reach the admin login page.
# ADMIN_ALLOWED_IPS=203.0.113.7
